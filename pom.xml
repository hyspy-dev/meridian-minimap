<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>meridian</groupId>
    <artifactId>meridian-minimap</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <!-- In-game minimap HUD module. Layer-1 (Jedi) — observes UpdateWorldMap /
         ClientMovement / JoinWorld and writes CustomHud back to the client, so
         it touches raw meridian-protocol UI packets directly. The 44×44 colour
         grid trick is borrowed from Landscaper's SimpleMinimap plugin —
         each cell is a tiny Panel element addressed by selector, mutated via
         differential Set commands every tick. -->
    <properties>
        <meridian.protocol.version>245610536</meridian.protocol.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>meridian</groupId>
            <artifactId>meridian-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- Jedi opt-in: CustomHud / UpdateWorldMap / ClientMovement etc. -->
        <dependency>
            <groupId>meridian</groupId>
            <artifactId>meridian-protocol</artifactId>
            <version>${meridian.protocol.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- EntityTracker for the local player position; tracker also publishes
             yaw via its own observers, but we don't strictly need core for the
             MVP — kept on for the future settings page. -->
        <dependency>
            <groupId>meridian</groupId>
            <artifactId>meridian-core-api</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.1.100.Final</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.9</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
